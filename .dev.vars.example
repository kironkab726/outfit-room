# 이 파일을 .dev.vars 로 복사해서 키를 채우면 내 컴퓨터에서 실제 모드로 돌아갑니다.
# 비워 두면 그 기능만 데모 모드(예시 데이터)로 동작합니다.
# 실제 사이트에는 Cloudflare 대시보드 > 워커 > 설정 > 변수 및 비밀(Secret)로 넣으세요.

# 코디 추천 + 쇼핑몰 상품 검색 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# 가상 피팅 (https://fal.ai/dashboard/keys)
FAL_KEY=
# (선택) 가상 피팅 모델 바꾸기
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6
# (선택) 입장 코드: 정하면 이 코드를 아는 사람만 유료 API를 쓸 수 있음 (요금 폭탄 방지)
ACCESS_CODE=
